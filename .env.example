# GEMINI_API_KEY: Key API Google Gemini untuk AI Chatbot & Rekomendasi
GEMINI_API_KEY="AIzaSy..."

# PostgreSQL Database Settings (Cloud SQL atau Local PostgreSQL)
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="your_password_here"
SQL_DB_NAME="libra_db"

# SQL Admin credentials (digunakan oleh drizzle-kit untuk migrasi)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_password_here"

# Application URL
APP_URL="http://localhost:3000"
